<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planilla de Gastos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script type="module" src="app.js"></script>
    <style>
        body { background-color: #0b1120; color: #f1f5f9; font-family: ui-sans-serif, system-ui, sans-serif; }
        .card-bg { background-color: #111827; border: 1px solid #1e293b; }
        .table-header { background-color: #0f172a; border-bottom: 1px solid #1e293b; }
        .text-green-accent { color: #10b981; }
        .text-blue-accent { color: #6366f1; }
        .tab-btn-active { border-bottom: 2px solid #10b981; color: #10b981; font-weight: 700; }
    </style>
</head>
<body class="min-h-screen pb-12">
<!-- LOGIN OVERLAY -->
<div id="loginOverlay" class="fixed inset-0 bg-slate-950 flex items-center justify-center p-4 z-50">
    <div class="card-bg p-8 rounded-2xl max-w-md w-full text-center border border-slate-800 shadow-2xl">
        <div class="w-16 h-16 bg-emerald-950/80 border border-emerald-800/60 rounded-2xl flex items-center justify-center text-emerald-400 mx-auto mb-4 text-2xl">
            <i class="fa-solid fa-lock"></i>
        </div>
        <h2 class="text-xl font-bold text-white mb-2">Acceso Protegido</h2>
        <p class="text-xs text-slate-400 mb-6">Ingresá tus credenciales para acceder a tu planilla.</p>
        
        <form id="formLogin" onsubmit="window.handleLogin(event)" class="space-y-4 text-left">
            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Correo Electrónico</label>
                <input type="email" id="loginEmail" required placeholder="tucorreo@email.com" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-emerald-500">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Contraseña</label>
                <input type="password" id="loginPassword" required placeholder="••••••••" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-emerald-500">
            </div>
            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-3 px-4 rounded-xl shadow-lg transition flex items-center justify-center gap-2 mt-2">
                <i class="fa-solid fa-right-to-bracket"></i> Iniciar Sesión
            </button>
        </form>
        <p id="loginError" class="text-xs text-rose-400 font-medium mt-4 hidden"></p>
    </div>
</div>
    <div id="loadingOverlay" class="fixed inset-0 bg-slate-950 flex items-center justify-center p-4 z-50 hidden"><div class="animate-spin w-12 h-12 border-4 border-emerald-500/20 border-t-emerald-500 rounded-full"></div></div>

    <!-- CONTENIDO APP -->
    <div id="appContent" class="hidden">
        <header class="max-w-7xl mx-auto px-4 pt-6 pb-2">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-950 flex items-center justify-center text-emerald-400"><i class="fa-solid fa-wallet text-xl"></i></div>
                    <div><h1 class="text-xl font-bold text-white">Control de Gastos</h1><p class="text-xs text-slate-400" id="grupoStatus">Cargando...</p></div>
                </div>
                <div class="flex items-center bg-slate-900 border border-slate-800 rounded-lg px-2 py-1">
                    <button onclick="navigateMonth(-1)" class="text-slate-400 hover:text-white px-3 py-1"><i class="fa-solid fa-chevron-left"></i></button>
                    <span id="displayMonthText" class="text-sm font-bold text-white px-4 min-w-[140px] text-center">Cargando...</span>
                    <button onclick="navigateMonth(1)" class="text-slate-400 hover:text-white px-3 py-1"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="openModalGasto()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium px-4 py-2 rounded-lg flex items-center gap-2"><i class="fa-solid fa-circle-plus"></i> Nuevo Gasto</button>
                    <button onclick="cerrarSesion()" class="p-2.5 rounded-lg card-bg text-slate-400 hover:text-rose-400"><i class="fa-solid fa-right-from-bracket"></i></button>
                </div>
            </div>
            <!-- Navegación por Archivos HTML -->
            <div class="flex border-b border-slate-800 overflow-x-auto">
                <a href="planilla_gasto.html" class="px-5 py-2.5 text-sm font-semibold tab-btn-active flex items-center gap-2"><i class="fa-solid fa-table-list"></i> Planilla de Gastos</a>
                <a href="analisis_grafico.html" class="px-5 py-2.5 text-sm font-semibold text-slate-400 hover:text-white flex items-center gap-2"><i class="fa-solid fa-chart-pie"></i> Análisis y Gráficos</a>
                <a href="saldo_banco.html" class="px-5 py-2.5 text-sm font-semibold text-slate-400 hover:text-white flex items-center gap-2"><i class="fa-solid fa-building-columns text-emerald-400"></i> Saldos y Bancos</a>
                <a href="gasto_hormiga.html" class="px-5 py-2.5 text-sm font-semibold text-slate-400 hover:text-white flex items-center gap-2"><i class="fa-solid fa-cookie-bite text-amber-400"></i> Gastos Hormiga</a>
            </div>
        </header>

        <main class="max-w-7xl mx-auto px-4 py-4 space-y-6">
            <!-- MÉTRICAS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <div class="card-bg p-5 rounded-2xl"><span class="text-xs font-bold text-slate-400 uppercase">SUELDO</span><h2 id="cardSueldo" class="text-2xl font-extrabold text-green-accent my-1">$ 0,00</h2></div>
                <div class="card-bg p-5 rounded-2xl"><span class="text-xs font-bold text-slate-400 uppercase">GASTOS FIJOS</span><h2 id="cardGastosFijos" class="text-2xl font-extrabold text-amber-500 my-1">$ 0,00</h2></div>
                <div class="card-bg p-5 rounded-2xl"><span class="text-xs font-bold text-slate-400 uppercase">TARJETAS</span><h2 id="cardTarjetas" class="text-2xl font-extrabold text-blue-accent my-1">$ 0,00</h2></div>
                <div class="card-bg p-5 rounded-2xl"><span class="text-xs font-bold text-slate-400 uppercase">TOTALES</span><h2 id="cardGastosTotales" class="text-2xl font-extrabold text-rose-500 my-1">$ 0,00</h2></div>
                <div class="card-bg p-5 rounded-2xl"><span class="text-xs font-bold text-slate-400 uppercase">RESTO</span><h2 id="cardResto" class="text-2xl font-extrabold text-green-accent my-1">$ 0,00</h2></div>
            </div>
            <!-- TABLA -->
            <div class="card-bg rounded-2xl overflow-hidden shadow-xl">
                <div class="px-6 py-4 border-b border-slate-800 flex justify-between items-center">
                    <h3 class="text-lg font-bold text-white">Planilla Agrupada</h3>
                    <span id="badgeMonth" class="text-xs bg-slate-800 text-slate-300 px-3 py-0.5 rounded-full">...</span>
                </div>
                <div id="containerPlanillaAgrupada" class="p-4 space-y-4"></div>
            </div>
        </main>
    </div>
    <!-- Script específico de la vista de Planilla -->
    <script>
        function renderApp() {
            const currentMonth = window.appState.currentMonth || '2026-06';
            if(document.getElementById('displayMonthText')) document.getElementById('displayMonthText').innerText = window.formatMonthDisplay(currentMonth);
            if(document.getElementById('badgeMonth')) document.getElementById('badgeMonth').innerText = window.formatMonthDisplay(currentMonth);

            const { sueldoActual, items, totalFijos, totalTarjetas } = window.getCalculatedDataForMonth(currentMonth);
            const totalGastosMes = totalFijos + totalTarjetas;
            const fmt = num => "$ " + num.toLocaleString('es-AR', { minimumFractionDigits: 2 });

            if(document.getElementById('cardSueldo')) document.getElementById('cardSueldo').innerText = fmt(sueldoActual);
            if(document.getElementById('cardGastosFijos')) document.getElementById('cardGastosFijos').innerText = fmt(totalFijos);
            if(document.getElementById('cardTarjetas')) document.getElementById('cardTarjetas').innerText = fmt(totalTarjetas);
            if(document.getElementById('cardGastosTotales')) document.getElementById('cardGastosTotales').innerText = fmt(totalGastosMes);
            if(document.getElementById('cardResto')) document.getElementById('cardResto').innerText = fmt(sueldoActual - totalGastosMes);
        }
    </script>
</body>
</html>
